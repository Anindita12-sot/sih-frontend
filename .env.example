# Copy this file to .env.local and adjust. Never commit .env.local.
# Only variables prefixed with VITE_ are exposed to the browser, so never put
# secrets (API keys, DB credentials) in this file — everything here is public.

# Name shown in the sidebar, login screen, and page title.
VITE_APP_NAME="SIH Platform"

# Base URL the frontend calls.
# Leave as /api to use the Vite dev proxy (see VITE_DEV_PROXY_TARGET).
# Set to a full URL (e.g. https://api.example.com) when the backend is deployed.
VITE_API_BASE_URL="/api"

# true  -> use the built-in mock backend in src/services/mock (demo data)
# false -> call the real backend at VITE_API_BASE_URL
# MUST be false for the final SIH submission.
VITE_USE_MOCK_API="true"

# Abort requests that take longer than this (milliseconds).
VITE_API_TIMEOUT_MS="20000"

# Dev-server only. When set, /api requests are proxied here, which avoids CORS
# errors during local integration. Example: http://localhost:8000
VITE_DEV_PROXY_TARGET=""
